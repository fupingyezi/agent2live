{
  "name": "agent2live",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "build": "pnpm -r build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "pack:desktop": "node scripts/package-desktop.mjs",
    "check:plans-ignored": "node scripts/check-plans-ignored.mjs",
    "check:no-prohibited": "node scripts/check-no-prohibited-assets.mjs",
    "check:workspace": "node scripts/check-workspace.mjs",
    "check": "pnpm format:check && pnpm typecheck && pnpm test && pnpm check:plans-ignored && pnpm check:no-prohibited",
    "bench:data": "pnpm --filter @agent2live/server bench:data"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@playwright/test": "^1.65.0",
    "@types/node": "^26.6.6",
    "ag-psd": "^34.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.18.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
