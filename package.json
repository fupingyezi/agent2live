{
  "name": "agent2live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "typecheck:workspace": "pnpm -r --if-present typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.json",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "typecheck:spikes": "tsc --noEmit -p tsconfig.spikes.json",
    "typecheck": "pnpm typecheck:workspace && pnpm typecheck:root && pnpm typecheck:e2e && pnpm typecheck:spikes",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "render:matrix": "tsx scripts/render-matrix.ts",
    "build": "pnpm -r build",
    "build:server": "pnpm --filter @agent2live/server build",
    "build:desktop": "pnpm --filter @agent2live/desktop build",
    "format": "prettier --write . --ignore-unknown",
    "format:check": "prettier --check . --ignore-unknown",
    "pack:desktop": "node scripts/package-desktop.mjs",
    "native:node": "node scripts/rebuild-native.mjs node",
    "native:electron": "node scripts/rebuild-native.mjs electron",
    "check:plans-ignored": "node scripts/check-plans-ignored.mjs",
    "check:no-prohibited": "node scripts/check-no-prohibited-assets.mjs",
    "check:tsx-style": "node scripts/check-tsx-style.mjs",
    "check:code-comments": "node scripts/check-code-comments.mjs",
    "check:code-style": "node --test scripts/code-style.test.mjs && pnpm check:tsx-style && pnpm check:code-comments",
    "check:workspace": "node scripts/check-workspace.mjs",
    "spike:psd2live:fixture": "tsx spikes/psd2live/make-fixture.ts",
    "spike:psd2live:cli": "tsx spikes/psd2live/cli-probe.ts",
    "spike:psd2live:probe": "tsx spikes/psd2live/probe.ts",
    "probe:codex": "tsx spikes/agents/codex-probe.ts",
    "probe:claude": "tsx spikes/agents/claude-probe.ts",
    "phase0:gate": "node scripts/phase0-gate.mjs",
    "test:gate": "node --test scripts/phase0-gate.test.mjs",
    "phase0:evidence": "node scripts/write-gate-evidence.mjs",
    "phase0:docs": "node scripts/check-official-sources.mjs",
    "check": "pnpm format:check && pnpm check:code-style && pnpm typecheck && pnpm test && pnpm test:gate && pnpm check:plans-ignored && pnpm check:no-prohibited",
    "bench:data": "pnpm --filter @agent2live/server bench:data"
  },
  "devDependencies": {
    "@agent2live/live2d-runtime": "workspace:*",
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@anthropic-ai/sdk": "1.6.0",
    "@electron/rebuild": "^4.2.1",
    "@modelcontextprotocol/sdk": "1.32.2",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.20.5",
    "ag-psd": "^34.1.0",
    "electron": "44.7.2",
    "electron-builder": "^26.18.0",
    "prettier": "3.6.2",
    "sharp": "0.35.5",
    "tsup": "^9.0.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4",
    "zod": "4.6.7"
  }
}
