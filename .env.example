# Optional environment variables for real (non-mock) smoke runs.
# Copy this file to `.env` and fill in values locally.
# Never commit secrets. Mock mode is the default and needs none of these.
#
# Real-provider smoke modes:
#   1      run both DeepSeek-compatible Chat and Seedream Image probes
#   image  run only the Seedream Image probe
#   vision run only the Zhipu reference-image reverse probe
# Keep this commented until both Chat and Image values are ready.
# AGENT2LIVE_REAL_PROVIDERS=1
#
# DeepSeek Chat (OpenAI-compatible)
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_API_KEY=sk-...
#
# Or override the generic Chat settings directly:
# AGENT2LIVE_REAL_CHAT_BASE_URL=https://api.deepseek.com/v1
# AGENT2LIVE_REAL_CHAT_MODEL=deepseek-chat
# AGENT2LIVE_REAL_CHAT_API_KEY=sk-...
#
# Zhipu vision reverse
ZHIPU_API_KEY=
ZHIPU_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AGENT2LIVE_REAL_VISION_MODEL=glm-5.3-flash
#
# Seedream Image
# AGENT2LIVE_REAL_IMAGE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# AGENT2LIVE_REAL_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
# AGENT2LIVE_REAL_IMAGE_API_KEY=
# SEEDREAM_API_KEY=ark-...
