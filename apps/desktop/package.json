{
  "name": "@agent2live/desktop",
  "productName": "agent2live",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "AGENT2LIVE_DEV_SIDECAR_WATCH=1 electron-vite dev --watch",
    "build": "electron-vite build",
    "pack:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "app.agent2live.phase0",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": ".packaged-server",
        "to": "server",
        "filter": [
          "index.cjs",
          "index.cjs.map",
          "package.json",
          "migrations/**"
        ]
      },
      {
        "from": ".packaged-server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "mac": {
      "target": "dir",
      "identity": null
    }
  },
  "dependencies": {
    "@agent2live/contracts": "workspace:*",
    "@agent2live/design-system": "workspace:*",
    "@agent2live/live2d-runtime": "workspace:*",
    "@fontsource/noto-sans-sc": "^5.3.1",
    "@pixi/unsafe-eval": "7.4.3",
    "@tanstack/react-query": "^5.107.1",
    "pixi-live2d-display-lipsyncpatch": "0.5.0-ls-8",
    "pixi.js": "7.4.3",
    "react-router-dom": "^7.18.5",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.2",
    "electron-vite": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "7.3.7"
  }
}
