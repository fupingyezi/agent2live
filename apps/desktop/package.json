{
  "name": "@agent2live/desktop",
  "version": "0.1.0",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:dir": "electron-builder --dir",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "build": {
    "appId": "app.agent2live.phase0",
    "directories": {
      "output": "release"
    },
    "asar": true,
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server/dist",
        "to": "server"
      },
      {
        "from": "../server/migrations",
        "to": "server/migrations"
      },
      {
        "from": "../server/node_modules",
        "to": "server/node_modules"
      }
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "npmRebuild": true,
    "mac": {
      "target": "dir",
      "identity": null
    }
  },
  "dependencies": {
    "@pixi/unsafe-eval": "7.4.3",
    "pixi-live2d-display-lipsyncpatch": "0.5.0-ls-8",
    "pixi.js": "7.4.3"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "44.7.2",
    "electron-vite": "5.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "vite": "7.3.7"
  }
}
